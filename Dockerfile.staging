# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /src

# Download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application (Staging build)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /src/gcw main.go

# Final stage
FROM alpine:latest

WORKDIR /app

# Install CA certificates for external HTTPS calls (e.g. Midtrans)
RUN apk --no-cache add ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /src/gcw .
# Copy keys for JWT and Audit logs
COPY --from=builder /src/keys ./keys

EXPOSE 8000

CMD ["./gcw"]
